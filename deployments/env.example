# deployments/env.example — Environment variables for seele-cloud.
#
# All required env var names + format. Phase 1 only needs the basic Worker
# identity + CF Access allowlist echo (CF Access policies themselves live
# in the Cloudflare dashboard; see worker/README.md "CF Access policies").
# Phase 2+ adds the bindings + JWT signing material.
#
# NEVER commit real values; use .dev.vars locally and Cloudflare dashboard
# secrets in production.

# --- Worker identity (Phase 1) ---
ENVIRONMENT="staging"      # staging | production
CORS_ALLOWED_ORIGINS="https://seele.agency,http://localhost:3000"
ORIGIN_URL="https://griptoad26.github.io"
LAST_REINDEX_AT=""          # bumped by the reindex cron (Phase 4)

# --- Cloudflare Access (Phase 1: document only; Phase 2: enforced) ---
# Allowlist of emails that can hit /api/* via CF Access email-link.
# Multiple addresses comma-separated. Wildcards (`*@griptoad.com`) supported.
CF_ACCESS_ALLOWED_EMAILS="dev@griptoad.com"

# --- Cloudflare account metadata (output of `wrangler whoami`) ---
CF_ACCOUNT_ID="REPLACE_WITH_ACCOUNT_ID"
CF_ZONE_ID="REPLACE_WITH_ZONE_ID"

# --- Vectorize (Phase 1 binding; Phase 4 holds the vectors) ---
VECTORIZE_INDEX="seele-memory-embeddings"

# --- D1 (Phase 1 binding; Phase 2 writes to it) ---
D1_DATABASE_ID="REPLACE_WITH_D1_DATABASE_ID"
D1_DATABASE_NAME="seele-memory-db"

# --- Bot grant JWT (Phase 4) ---
# 32-byte random hex. Generated once, stored in CF dashboard secrets.
GRANT_JWT_SECRET="REPLACE_WITH_32_BYTE_RANDOM_HEX"
GRANT_JWT_DEFAULT_TTL_SECONDS="900"   # 15 minutes
